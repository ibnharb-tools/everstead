# Copy this file to .env and fill in values before running

# SQLite for development; use postgresql+asyncpg://... for production
DATABASE_URL=sqlite+aiosqlite:///./everstead.db

# Generate a strong random secret for production: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-in-production

# Comma-separated list of allowed CORS origins (use * to allow all, lock down in production)
CORS_ORIGINS=*

# Set to false to use offline synthetic climate data (no NASA POWER calls)
ALLOW_NETWORK=true
